{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://closette.local/muse/feedback.schema.json",
  "title": "POST /v1/outfits/feedback",
  "type": "object",
  "required": ["recommendation_id", "outfit_id", "action"],
  "properties": {
    "recommendation_id": { "type": "string", "minLength": 1 },
    "outfit_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string" },
    "action": { "enum": ["like", "save", "dislike", "dismiss", "worn"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "reason": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
