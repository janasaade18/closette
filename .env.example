# App
PORT=3000
NODE_ENV=development

# MongoDB is no longer required to boot the API. Foot scans live in Supabase.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/closette

# Supabase — foot model tables + frame storage.
# Apply supabase/migrations/20261007_foot_model.sql in the SQL editor first.
# Dashboard: https://supabase.com/dashboard/project/ntrfbndjtdlghnbbxxtz
SUPABASE_URL=https://ntrfbndjtdlghnbbxxtz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FOOT_SCANS_BUCKET=foot-scans

# Optional Phase 1 Python worker (backend/reconstruction)
RECONSTRUCTION_WORKER_URL=http://127.0.0.1:8001
# Windows COLMAP launcher. Leave empty to use `colmap` on PATH.
COLMAP_BIN=
