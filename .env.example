# App
PORT=3000
NODE_ENV=development

# MongoDB is no longer required to boot the API. Foot scans live in Supabase.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/closette

# Supabase — foot model tables + frame storage.
# Apply supabase/migrations/20261007_foot_model.sql in the SQL editor first.
# Dashboard: https://supabase.com/dashboard/project/ntrfbndjtdlghnbbxxtz
SUPABASE_URL=https://ntrfbndjtdlghnbbxxtz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FOOT_SCANS_BUCKET=foot-scans
# Apply supabase/migrations/20261107_garments_wardrobe.sql and create this bucket.
SUPABASE_WARDROBE_IMAGES_BUCKET=wardrobe-images
# Apply supabase/migrations/20261113_brand_collabs.sql before using /brands.
# Brand logins are created by this API with SUPABASE_SERVICE_ROLE_KEY.
# Do not send that key to the mobile app.

# Optional Phase 1 Python worker (backend/reconstruction)
RECONSTRUCTION_WORKER_URL=http://127.0.0.1:8001
# Windows COLMAP launcher. Leave empty to use `colmap` on PATH.
COLMAP_BIN=

# Muse outfits service (ranker / recommend). Chat calls this — does not rewrite it.
MUSE_URL=http://127.0.0.1:8787
# Free Gemini key from Google AI Studio (https://aistudio.google.com/apikey).
# Used only by POST /muse/chat. Do not commit real keys.
GEMINI_API_KEY=
# Optional preferred model; on 503 high-demand Muse retries then falls back
# to other Flash / Flash-Lite models automatically.
# MUSE_CHAT_MODEL=gemini-flash-lite-latest

