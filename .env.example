# App
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/closette

# Supabase (foot scan storage)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FOOT_SCANS_BUCKET=foot-scans

# Optional Phase 1 Python worker (backend/reconstruction)
RECONSTRUCTION_WORKER_URL=http://127.0.0.1:8001

# PostgreSQL
POSTGRES_URI=postgresql://<username>:<password>@<host>:5432/closette

# JWT Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_WARDROBE=wardrobe-images
AZURE_CONTAINER_PROFILE=profile-images
AZURE_CONTAINER_AR=ar-assets
AZURE_CONTAINER_CATALOGUE=catalogue-images

# Weather API
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=